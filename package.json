{
  "name": "vox-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord voice bot that hears people and answers out loud.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "node scripts/check.mjs",
    "demo": "tsx scripts/demo.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^2.26.0",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.27.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  }
}
